# 서버 환경 변수 (orchestration_server.md §3.1). 실제 값은 .env(커밋 금지) 또는 systemd EnvironmentFile
PORT=3000
# 공개 주소(도메인, D18). 비우면 http://localhost:3000
PUBLIC_ORIGIN=
DATA_DIR=data
ADMINS_FILE=config/admins.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
PRIVACY_CONTACT=
# 개발·E2E 전용 가짜 로그인. 프로덕션은 0
AUTH_FAKE=1
# 백업(선택): age 공개키·rclone 원격. 비우면 data/backups 로컬 14개만
BACKUP_AGE_RECIPIENT=
BACKUP_RCLONE_REMOTE=
