# 일일 작업 (03 §3.8 표 1~7) — drilldown-daily.timer 가 04:00 에 실행
[Unit]
Description=Drill Down daily maintenance

[Service]
Type=oneshot
User=drilldown
Group=drilldown
WorkingDirectory=/opt/drilldown
EnvironmentFile=/etc/drilldown/env
# 가짜 로그인은 env 파일에 남아 있어도 끈다 — 뒤의 Environment= 가 이긴다(s1 H1·s4 H1)
Environment=AUTH_FAKE=0
Environment=DATA_DIR=/var/lib/drilldown
ExecStart=/usr/bin/node --no-warnings=ExperimentalWarning server/account/daily.ts
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/drilldown
